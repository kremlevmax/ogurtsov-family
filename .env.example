# Пример переменных окружения. Скопируйте в .env.local и заполните
# реальными значениями. Этот файл не должен содержать секретов —
# только имена переменных и пояснения.
#
# До выбора домена используйте нейтральные значения (например,
# http://localhost:3000 для разработки).

# Публичный URL сайта. Используется для абсолютных ссылок в SEO
# (sitemap, canonical, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: URL проекта и публичный anon key. Оба значения безопасны
# для браузера, так как доступ на запись ограничен через RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. НИКОГДА не используется в браузере и не
# импортируется в клиентские компоненты. Нужен только серверным
# скриптам обслуживания (например, backup:local), если потребуется.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: доступ для серверной генерации presigned URL на
# загрузку файлов (Этап 4). Секретный ключ не должен покидать сервер.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Публичный адрес Cloudflare Worker, отдающего файлы из R2 (Этап 4).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Код приглашения для регистрации в «Семейной гостиной» (/lounge/register).
# Проверяется только на сервере (server/actions/lounge-auth.ts), никогда
# не попадает в клиентский бандл и не хранится в базе. Сообщите его
# только реальным родственникам.
LOUNGE_INVITE_CODE=

# Те же данные Gmail-аккаунта, что уже введены в Supabase Dashboard →
# Authentication → SMTP Settings (docs/SETUP_SUPABASE.md, раздел 8) —
# используются здесь ещё раз, чтобы сам сайт (не Supabase) мог послать
# письма о заявках на доступ к дереву (lib/email/send-notification.ts):
# редакторам — когда участник зарегистрировался без кода приглашения,
# самому участнику — когда редактор одобрил его доступ.
# SMTP_EMAIL_PASSWORD — это пароль приложения Gmail, не обычный пароль
# от аккаунта.
SMTP_EMAIL_USER=
SMTP_EMAIL_PASSWORD=

# Email обоих редакторов через запятую — куда приходит уведомление о
# новом участнике, зарегистрировавшемся без кода приглашения
# (server/actions/lounge-auth.ts).
NOTIFY_EDITOR_EMAILS=
